# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTHENTICATION & SECURITY
# Secret key used for signing JWT session tokens and hashing OTP salts.
AUTH_SECRET="your-32-char-random-secure-secret-key-replace-in-production"

# SMS / OTP PROVIDER CONFIGURATION
# Supported providers: "DEVELOPMENT" (in-app preview log), "TWILIO", "FAST2SMS", "MSG91", "CUSTOM_WEBHOOK"
SMS_PROVIDER="DEVELOPMENT"

# Twilio Configuration (if SMS_PROVIDER="TWILIO")
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Fast2SMS Configuration (India) (if SMS_PROVIDER="FAST2SMS")
FAST2SMS_API_KEY="your_fast2sms_authorization_key"

# MSG91 Configuration (if SMS_PROVIDER="MSG91")
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_TEMPLATE_ID="your_msg91_otp_template_id"

# Generic SMS Webhook (if SMS_PROVIDER="CUSTOM_WEBHOOK")
SMS_WEBHOOK_URL="https://your-sms-gateway.example.com/api/send"

